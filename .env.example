# Modèle des variables d'environnement. Copier en `.env` et renseigner.
# Aucune valeur réelle ici : ce fichier est versionné.
#
# Trois environnements : local, `staging` sur Vercel (branche git `preprod`,
# base Neon Preproduction) et la production. Les colonnes « staging » des
# commentaires ci-dessous indiquent ce qui doit impérativement différer.

# --- Base de données -------------------------------------------------------

# Branche Neon Production (endpoint ep-odd-river). C'est la valeur par défaut
# du .env local : toute commande Prisma sans préfixe explicite s'y adresse.
DATABASE_URL=

# Branche Neon Preproduction (endpoint ep-square-lake). LOCAL UNIQUEMENT :
# le code ne lit jamais cette variable, il ne connaît que DATABASE_URL. Elle
# sert au script `pnpm dev:preprod`, qui l'extrait de ce fichier et la
# substitue à DATABASE_URL le temps du processus.
#
# Sur Vercel il ne faut PAS la créer : c'est le DATABASE_URL de l'environnement
# `staging` qui porte directement l'URL de préproduction.
PREPROD_DATABASE_URL=

# --- Secrets ---------------------------------------------------------------

# Signature des cookies `authToken` et des jetons d'invitation `set-password`.
# DOIT différer entre staging et production : partagé, un jeton émis par
# staging serait valide en production.
JWT_SECRET=

# Attendu en `Authorization: Bearer` par les crons Vercel. Sans lui, les cinq
# crons nocturnes reçoivent un 401 et toute la chaîne de synchronisation
# s'arrête silencieusement. À faire différer aussi entre staging et production.
CRON_SECRET=

# --- Apimo -----------------------------------------------------------------

# Identifiants de l'API Apimo (Basic auth). Lecture seule : l'application
# n'écrit jamais chez Apimo. Les appels de staging comptent dans les quotas.
USERNAME=
PASSWORD=

# --- URL publique ----------------------------------------------------------

# Racine des liens composés dans les emails. FACULTATIVE : à défaut,
# `baseUrl()` (src/lib/environnement.ts) se replie sur VERCEL_BRANCH_URL,
# l'alias stable de la branche déployée, puis sur http://localhost:3000.
#
# Ne rien poser sur `staging` : le repli automatique suffit et suit la branche.
# La production la définit explicitement.
#
# Si vous la renseignez : schéma inclus, et jamais d'URL de déploiement
# (`…-27sv8iucn-….vercel.app`), qui change à chaque push — l'alias de branche
# (`…-git-preprod-….vercel.app`) est la forme stable.
NEXT_PUBLIC_BASE_URL=

# --- SMTP ------------------------------------------------------------------

SMTP_SERVER_HOST=
SMTP_SERVER_PORT=
SMTP_SERVER_USERNAME=
SMTP_SERVER_PASSWORD=
SMTP_FROM_EMAIL=

# Repli des destinataires admin quand FACTURES_ADMIN_EMAILS n'est pas défini.
SMTP_TO_EMAIL=

# --- Emails : destinataires et déroutage -----------------------------------
# Voir `src/lib/environnement.ts`, point d'entrée unique.

# Destinataires des notifications de facture adressées à l'administration
# (`/api/factures/send`), liste séparée par des virgules. À défaut, repli sur
# SMTP_TO_EMAIL seul. À renseigner en production, sans quoi les destinataires
# historiques autres que SMTP_TO_EMAIL ne reçoivent plus rien.
FACTURES_ADMIN_EMAILS=

# Adresse recevant TOUT le courrier hors production. Facultative : le défaut
# est en dur dans environnement.ts.
EMAIL_REDIRECTION=

# --- Bypass d'authentification (développement local uniquement) ------------
# `src/lib/devAuth.ts` refuse le bypass dès que NODE_ENV vaut "production",
# donc sans effet sur Vercel. Le rôle ci-dessous est appliqué par les gardes
# API : travailler dans /admin avec `conseiller` donne des 403.

NEXT_PUBLIC_AUTH_DISABLED=
NEXT_PUBLIC_TEST_USER_ID=
NEXT_PUBLIC_TEST_USER_NAME=
NEXT_PUBLIC_TEST_USER_EMAIL=
NEXT_PUBLIC_TEST_USER_ROLE=

# --- Ne jamais définir ------------------------------------------------------
#
# VERCEL_ENV est fourni par Vercel et distingue la production du reste. Le
# poser à la main dans un .env local ferait partir de vrais emails aux
# conseillers depuis votre machine.
